# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_size = 2
continuation_indent_size = 2
max_line_length = 120

[*.xml]
indent_size = 4

[*.properties]
indent_size = 4

[*.yml]
indent_size = 4

[*.yaml]
indent_size = 4
